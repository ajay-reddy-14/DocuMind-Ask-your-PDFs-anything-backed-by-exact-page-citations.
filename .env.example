# ─── Database ───────────────────────────────────────────────────────────────
# Connection string for a PostgreSQL instance with the pgvector extension.
# Example: postgresql://user:password@localhost:5432/documind
DATABASE_URL=postgresql://user:password@localhost:5432/documind

# ─── Session / Security ──────────────────────────────────────────────────────
# A long, random secret used to sign session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_secret_string

# ─── Google Gemini ───────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
# Chat / generation model
GEMINI_CHAT_MODEL=gemini-2.0-flash
# Embedding model
GEMINI_EMBEDDING_MODEL=text-embedding-004
# Must match the output dimensionality of the embedding model above
EMBEDDING_DIMENSIONS=768

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
# Allow requests from this origin (the Vite dev server or deployed frontend URL)
CLIENT_URL=http://localhost:5173

# ─── File uploads ────────────────────────────────────────────────────────────
# Directory where uploaded PDFs are stored (relative to the server root)
UPLOAD_DIR=uploads
# Maximum allowed PDF size in megabytes
MAX_FILE_SIZE_MB=20

